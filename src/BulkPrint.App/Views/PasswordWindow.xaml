<Window x:Class="BulkPrint.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/Assets/BulkPrintManager.ico"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Text="This PDF is password-protected" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="FileText" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" />
        <TextBlock x:Name="WrongText" Text="That password was not correct. Please try again."
                   Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0" Visibility="Collapsed" />
        <CheckBox x:Name="ApplyToAll" Margin="0,12,0,0" />
        <TextBlock Text="The password is used only while BulkPrint Manager is open. It is never saved."
                   Style="{StaticResource MutedText}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Skip all" Style="{StaticResource SecondaryButton}" Click="OnSkipAll" Margin="0,0,8,0"
                    ToolTip="Skip every remaining password-protected document" />
            <Button Content="Skip this file" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnSkip" Margin="0,0,8,0" />
            <Button Content="Unlock" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
