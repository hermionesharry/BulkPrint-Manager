<Window x:Class="BulkPrint.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BulkPrint Manager"
        Width="540" Height="320"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="False"
        Icon="pack://application:,,,/Assets/BulkPrintManager.ico"
        Style="{x:Null}">
    <Border CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>
        <Grid Margin="36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="72" Height="72" />
                <StackPanel Margin="18,4,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BulkPrint Manager" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Print Hundreds of Documents. One Simple Workflow." FontSize="13.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24,0,0">
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="StatusText" Text="Starting…" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>

            <DockPanel Grid.Row="2">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" />
                <TextBlock Text="Designed and Developed by Harish Vaishnav" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
