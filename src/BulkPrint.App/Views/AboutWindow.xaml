<Window x:Class="BulkPrint.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BulkPrint Manager"
        Width="560" Height="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/Assets/BulkPrintManager.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" />
            <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="BulkPrint Manager" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Print Hundreds of Documents. One Simple Workflow." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,14">
            <StackPanel>
                <TextBlock x:Name="VersionText" Style="{StaticResource BodyText}" />
                <TextBlock x:Name="BuildText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                <TextBlock Text="Designed and Developed by Harish Vaishnav" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,14,0,0" />
                <TextBlock Text="Copyright © 2026 Harish Vaishnav. All rights reserved." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Licenses and acknowledgements for bundled components" Style="{StaticResource CardTitle}" />
            <TextBox x:Name="NoticesText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11.5" AcceptsReturn="True" />
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Open license file" Style="{StaticResource SecondaryButton}" Click="OnOpenLicenses" Margin="0,0,8,0" />
            <Button Content="Close" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
