<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BulkPrint Manager light palette: off-white background, navy text, professional blue actions. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F4F9" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E6EE" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#14213D" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6478" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8790A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F5FD6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A50B8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#163F92" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledFillBrush" Color="#C9D1DF" />
    <SolidColorBrush x:Key="HoverFillBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="PressedFillBrush" Color="#E2E8F2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1F5FD6" />
    <SolidColorBrush x:Key="DropZoneBrush" Color="#F8FAFD" />
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#AFC2E6" />
    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="#E9EDF3" />
</ResourceDictionary>
