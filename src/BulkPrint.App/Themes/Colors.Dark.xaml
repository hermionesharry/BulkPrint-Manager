<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BulkPrint Manager dark palette. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121620" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B2130" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#222A3B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2D3648" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8ECF4" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7B0C2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7C869B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B7CF0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A92F5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2C66CF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2F52" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledFillBrush" Color="#3A4357" />
    <SolidColorBrush x:Key="HoverFillBrush" Color="#273044" />
    <SolidColorBrush x:Key="PressedFillBrush" Color="#2F3A51" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="InfoBrush" Color="#7AA7F7" />
    <SolidColorBrush x:Key="DropZoneBrush" Color="#182033" />
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#3E5481" />
    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="#0E121A" />
</ResourceDictionary>
